# Discord public configuration
DISCORD_CLIENT_ID=
# Optional: keeps a fast guild-only registration path for local development.
DISCORD_TEST_GUILD_ID=
# Use global for the installable public bot; use guild only while developing.
DISCORD_COMMAND_SCOPE=global
DISCORD_MOD_LOG_CHANNEL_ID=
# Optional allowlist for DISCORD_TEST_GUILD_ID only. Other installed servers
# accept reports from channels visible to @everyone and reject private channels.
DISCORD_MONITORED_CHANNEL_IDS=

# Secrets: set locally or in the deployment provider, never commit real values
DISCORD_BOT_TOKEN=
GENLAYER_PRIVATE_KEY=
DATABASE_URL=

# GenLayer
GENLAYER_NETWORK=studionet
GENLAYER_CONTRACT_ADDRESS=0x01858Aad8C071fE3677588C6d3b107da47d879C8
# GENLAYER_RPC_URL=https://studio.genlayer.com/api
# Required for automatic context-aware review of candidate messages. Set false
# only if moderators should manually submit every contextual case.
AUTO_SUBMIT_HYBRID=true

# Hosting
PORT=8080
